# Optional overrides only. New installations and all CLI commands default to production.
TOPMEDIAI_MODE=live
TOPMEDIAI_ENV=production
# Built-in reviewed public release endpoints; users do not need to create or edit .env.
TOPMEDIAI_MEMBER_HOST=https://topmediai-member-api.imyfone.com
TOPMEDIAI_IMAGE_HOST=https://ai-api.imyfone.com
TOPMEDIAI_MUSIC_HOST=https://aimusic-api.topmediai.com
TOPMEDIAI_TTS_HOST=https://tts-api.imyfone.com
# Browser login saves credentials in the OS credential store. Optional explicit token override only.
TOPMEDIAI_TOKEN=
# Browser login uses approved HTTPS website and member origins; they may differ.
TOPMEDIAI_GATEWAY_HOST=
# Leave the optional legacy gateway blank for production direct APIs.
TOPMEDIAI_PRODUCTION_WEB_ORIGIN=https://www.topmediai.com
TOPMEDIAI_PRODUCTION_GATEWAY_HOST=
# setup/install/diagnose freeze public configuration from the shell; login also reads local .env.
# Generation consumes the logged-in account credits through the original backend.
# Paid submissions use valid quotes, explicit budgets and the conversation's confirmation rules.
# Direct music/video/TTS/STS routes need no generation opt-in in this release.
# Synchronous TTS/STS, STS cost previews and audio/video uploads; other business requests use 60 seconds.
TOPMEDIAI_AUDIO_TIMEOUT_MS=300000
# Original backend payload channel (1-4); separate from the MCP client identity.
TOPMEDIAI_SOURCE=4
# MCP client identity: 5=Codex, 6=Claude Code, 7=Cursor. Blank means unknown.
# Configure this per client launch, not in a shared .env.
MCP_CLIENT_SOURCE=
# Reference image uploads require separate permission for external storage.
# Choose a dedicated local directory; upload only files authorized for external storage.
TOPMEDIAI_UPLOAD_ROOT=
TOPMEDIAI_UPLOAD_HOST=https://tts-api.imyfone.com
# Leave blank to use the public production CDN.
TOPMEDIAI_UPLOAD_PUBLIC_ORIGIN=
# OSS credentials stay on the backend. Never place AccessKey/Secret in this file.
# Optional: TOPMEDIAI_DATA_DIR=C:/path/to/private-task-data

# Speech source uploads also require local FFmpeg/FFprobe and the dedicated upload root.

# Video/audio references for omni video generation. Shares the dedicated upload root.
# Local installed executables only; never downloaded automatically.
TOPMEDIAI_FFMPEG_PATH=ffmpeg
TOPMEDIAI_FFPROBE_PATH=ffprobe

# Install/setup/diagnose read shell overrides; login and direct startup also read .env.
# Public release commands support production only. See docs/production-switch.md.
