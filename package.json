{
  "name": "topmediai-mcp",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local Codex and Cursor MCP for TopMediai image, music, video generation and synchronous TTS/STS speech",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc && node scripts/build-image-preview.mjs",
    "start": "node dist/src/index.js",
    "diagnose": "npm run build && node dist/scripts/diagnose.js",
    "test": "npm run build && node --test --test-concurrency=4 dist/tests/*.test.js tests/*.test.mjs",
    "setup:plugin": "npm run build && node dist/scripts/setup-plugin.js",
    "setup:cursor": "npm run build && node dist/scripts/setup-cursor.js",
    "install:codex": "npm run build && node dist/scripts/install-codex.js",
    "install:cursor": "npm run build && node dist/scripts/install-cursor.js",
    "login": "npm run build && node dist/scripts/login.js",
    "logout": "npm run build && node dist/scripts/logout.js",
    "login:status": "npm run build && node dist/scripts/login-status.js",
    "check:public": "node scripts/check-public-content.mjs",
    "prepare:public": "node scripts/prepare-public-release.mjs"
  }
}
